# Discord Developer Portal: Applications > General Information / Bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: server ID for instant guild-scoped slash command deployment.
DISCORD_GUILD_ID=
# Discord user ID of the service operator. Used by the initial configuration flow.
BOT_OWNER_DISCORD_ID=

# Railway PostgreSQL (or a local PostgreSQL connection string)
DATABASE_URL=

# Required central OpenRouter key; default model is the free openrouter/free router.
OPENROUTER_API_KEY=

# 32 bytes as 64 hexadecimal characters. Required when user-supplied keys are enabled; keep it stable.
AI_KEY_ENCRYPTION_KEY=

NODE_ENV=development
