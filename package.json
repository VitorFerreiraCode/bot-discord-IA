{
  "name": "bot-discord-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de Discord para diagnosticar e organizar servidores usando IA.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "node dist/db/migrate.js",
    "commands:deploy": "tsx src/discord/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
